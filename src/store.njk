---
pagination:
  data: stores.stores
  size: 1
  alias: store
permalink: "/{{ store.slug }}/index.html"
eleventyComputed:
  title: "{{ store.name_full_en }}"
---
{% if store.tablecheck_url %}{% set resHref = store.tablecheck_url + "?utm_source=hp" %}{% set resExt = true %}{% elif store.tel_raw %}{% set resHref = "tel:+" + store.tel_raw %}{% set resExt = false %}{% else %}{% set resHref = "" %}{% set resExt = false %}{% endif %}
{# 予約導線が1つも無い場合は CTA を出さない（tel:+ の死にリンク防止） #}
{% set resAvail = resHref != "" %}
{% set pageUrl = "https://" ~ stores.brand.domain ~ "/" ~ store.slug ~ "/" %}
{% set ogImage = "https://" ~ stores.brand.domain ~ store.hero_image %}
{# 店舗ごとのコピー上書き（未指定なら元の文言にフォールバック） #}
{% set C = store.copy or {} %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>{{ store.name_full_en }}</title>

{% if stores.brand.ga4_id %}
<!-- Google tag (gtag.js) - GA4 -->
<script async src="https://www.googletagmanager.com/gtag/js?id={{ stores.brand.ga4_id }}"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', '{{ stores.brand.ga4_id }}', {
    'store_name': '{{ store.slug }}',
    'store_area': '{{ store.region }}',
    'brand': '{{ stores.brand.brand_slug }}'
  });
</script>
{% endif %}

<meta name="description" content="{{ C.meta_desc or (store.name_full_en ~ " — Halal wagyu tasting courses in " ~ store.city ~ ", " ~ store.pref ~ ". Muslim-friendly.") }}">
<meta property="og:title" content="{{ store.name_short }} · {{ store.city }}">
<meta property="og:description" content="{{ C.og_desc or ("Halal wagyu tasting courses in " ~ store.city ~ ", " ~ store.pref ~ ".") }}">
<meta property="og:type" content="restaurant">
<meta property="og:url" content="{{ pageUrl }}">
<meta property="og:image" content="{{ ogImage }}">
<meta property="og:site_name" content="{{ stores.brand.brand_name }}">
<meta property="og:locale" content="en_US">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ store.name_short }} · {{ store.city }}">
<meta name="twitter:image" content="{{ ogImage }}">
<link rel="canonical" href="{{ pageUrl }}">
<meta name="theme-color" content="#D10100">
<link rel="icon" href="/assets/icons/{{ store.slug }}.ico" sizes="any">
<link rel="icon" type="image/png" sizes="32x32" href="/assets/icons/{{ store.slug }}-32.png">
<link rel="apple-touch-icon" href="/assets/icons/{{ store.slug }}-180.png">

<!-- LCP: ヒーロー画像を先読み -->
<link rel="preload" as="image" href="{{ store.hero_image }}" fetchpriority="high">

{% if stores.brand.meta_pixel_id %}
<!-- Meta Pixel -->
<script>
!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
document,'script','https://connect.facebook.net/en_US/fbevents.js');
fbq('init', '{{ stores.brand.meta_pixel_id }}');
fbq('track', 'PageView');
</script>
<noscript><img height="1" width="1" style="display:none" alt="" src="https://www.facebook.com/tr?id={{ stores.brand.meta_pixel_id }}&ev=PageView&noscript=1"></noscript>
{% endif %}

{% if stores.brand.tiktok_pixel_id %}
<!-- TikTok Pixel -->
<script>
!function (w, d, t) { w.TiktokAnalyticsObject=t;var ttq=w[t]=w[t]||[];ttq.methods=["page","track","identify","instances","debug","on","off","once","ready","alias","group","enableCookie","disableCookie"],ttq.setAndDefer=function(t,e){t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}};for(var i=0;i<ttq.methods.length;i++)ttq.setAndDefer(ttq,ttq.methods[i]);ttq.instance=function(t){for(var e=ttq._i[t]||[],n=0;n<ttq.methods.length;n++)ttq.setAndDefer(e,ttq.methods[n]);return e},ttq.load=function(e,n){var i="https://analytics.tiktok.com/i18n/pixel/events.js";ttq._i=ttq._i||{},ttq._i[e]=[],ttq._i[e]._u=i,ttq._t=ttq._t||{},ttq._t[e]=+new Date,ttq._o=ttq._o||{},ttq._o[e]=n||{};var o=d.createElement("script");o.type="text/javascript",o.async=!0,o.src=i+"?sdkid="+e+"&lib="+t;var a=d.getElementsByTagName("script")[0];a.parentNode.insertBefore(o,a)};
